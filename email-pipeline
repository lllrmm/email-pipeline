#!/usr/bin/env bash
set -euo pipefail
script_root=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
if [ -f "$script_root/email-pipeline.py" ]; then
  root=$script_root
else
  root=${EMAIL_PIPELINE_CODE_ROOT:-"$HOME/email-pipeline-code"}
fi
python_bin=${EMAIL_PIPELINE_PYTHON:-"$root/.venv/bin/python3"}
if [ ! -x "$python_bin" ]; then
  python_bin=python3
fi
exec "$python_bin" "$root/email-pipeline.py" "$@"
