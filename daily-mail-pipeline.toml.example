timezone = "Asia/Hong_Kong"

[summarizer]
system_prompt_file = "summarizer-system-prompt.txt"

[summarizer.model]
provider = "deepseek"
name = "deepseek-flash"
base_url = "https://api.deepseek.com"
api_key = ""
api_key_env = "EMAIL_SUMMARY_DEEPSEEK_API_KEY"

[summarizer.opencode]
agent = "mail-analyzer"
timeout_seconds = 600

[aggregator]
system_prompt_file = "aggregator-system-prompt.txt"

[aggregator.model]
provider = "deepseek"
name = "deepseek-flash"
base_url = "https://api.deepseek.com"
api_key = ""
api_key_env = "EMAIL_SUMMARY_DEEPSEEK_API_KEY"

[aggregator.opencode]
agent = "mail-daily-aggregator"
timeout_seconds = 600

[orchestrator]
summarizer_concurrency = 8
token_refresh_check_seconds = 60
token_refresh_window_seconds = 300
log_level_file = "INFO"
log_level_console = "INFO"

[scanner]
concurrency = 1
log_level_file = "INFO"

[imap]
host = "outlook.office365.com"
port = 993
ssl = true
username = "rlidf@connect.ust.hk"
concurrency = 1

[watcher]
enabled = false
poll_seconds = 60
debounce_seconds = 10
log_level_file = "INFO"
log_level_console = "INFO"

[identity]
account = "outlook"

[throttle]
scan_delay_seconds = 0.0
read_delay_seconds = 0.0

[imap_retry]
waits = [20, 60]

[extraction]
max_body_chars = 12000

[attachments]
max_count_per_message = 10
max_inline_images_per_message = 5
max_single_file_mb = 15
max_total_file_mb = 30
max_extracted_text_chars = 30000
