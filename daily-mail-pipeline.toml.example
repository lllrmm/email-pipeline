timeout = 120
retries = 2
system_prompt_file = "system-prompt.txt"

[api]
base_url = "https://api.deepseek.com"
api_key_env = "EMAIL_SUMMARY_DEEPSEEK_API_KEY"

[model]
name = "deepseek-flash"

[summary]
backend = "opencode"

[opencode]
executable = "/home/daniel/.opencode/bin/opencode"
agent = "mail-analyzer"
model = "deepseek/deepseek-flash"
timeout_seconds = 600
concurrency = 8
runtime_root = "/home/daniel/.hermes/opencode-email-runtime"

[imap]
host = "outlook.office365.com"
port = 993
ssl = true
username = "rlidf@connect.ust.hk"
token_command = "/home/daniel/.hermes/email/outlook-token-refresh.sh"

[watch]
idle_accelerator_mailbox = "Inbox"
poll_seconds = 60
debounce_seconds = 10

[program]
timezone = "Asia/Hong_Kong"

[identity]
account = "outlook"
salt_path = "/home/daniel/.hermes/email/pipeline-id-salt"
database_path = "/home/daniel/.hermes/email/mail-index.sqlite3"

[concurrency]
mailbox_scan = 1
index = 4
summarize = 8

[throttle]
scan_delay_seconds = 0.0
read_delay_seconds = 0.0

[imap_retry]
waits = [20, 60]

[extraction]
max_body_chars = 12000

[attachments]
max_count_per_message = 10
max_inline_images_per_message = 5
max_single_file_mb = 15
max_total_file_mb = 30
max_extracted_text_chars = 30000

[request]
temperature = 0.2
max_tokens = 4000

[request.response_format]
type = "json_object"

[request.thinking]
type = "enabled"
