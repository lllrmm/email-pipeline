[Unit]
Description=Hermes durable new-mail queue consumer
After=network-online.target hermes-email-watch.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.hermes/scripts/email-pipeline
ExecStart=%h/.hermes/hermes-agent/venv/bin/python %h/.hermes/scripts/email-pipeline/email-pipeline.py consume
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
