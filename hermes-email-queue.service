[Unit]
Description=Hermes durable new-mail queue consumer
After=network-online.target hermes-email-watch.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/email-pipeline-code
ExecStart=%h/email-pipeline-code/.venv/bin/python %h/email-pipeline-code/email-pipeline.py consume
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=EMAIL_PIPELINE_CODE_ROOT=%h/email-pipeline-code
Environment=EMAIL_PIPELINE_CONFIG_ROOT=%h/.email-pipeline
Environment=EMAIL_PIPELINE_DATA_ROOT=%h/email-pipeline

[Install]
WantedBy=default.target
