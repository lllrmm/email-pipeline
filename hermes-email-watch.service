[Unit]
Description=Hermes IMAPClient new-mail watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.hermes/scripts/email-pipeline
ExecStart=%h/.hermes/hermes-agent/venv/bin/python %h/.hermes/scripts/email-pipeline/email-pipeline.py watch
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
