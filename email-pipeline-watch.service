[Unit]
Description=Email pipeline IMAPClient new-mail watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/hkust-email-ep
ExecStart=/usr/bin/python3 %h/email-pipeline-code/email-pipeline.py watch
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=EMAIL_PIPELINE_CODE_ROOT=%h/email-pipeline-code
Environment=EMAIL_PIPELINE_INSTANCE_ROOT=%h/hkust-email-ep

[Install]
WantedBy=default.target
