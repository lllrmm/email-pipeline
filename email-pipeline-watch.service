[Unit]
Description=Email pipeline IMAPClient new-mail watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/email-pipeline-code
ExecStart=/usr/bin/python3 %h/email-pipeline-code/email-pipeline.py watch
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=EMAIL_PIPELINE_CODE_ROOT=%h/email-pipeline-code
Environment=EMAIL_PIPELINE_CONFIG_ROOT=%h/.email-pipeline
Environment=EMAIL_PIPELINE_DATA_ROOT=%h/email-pipeline

[Install]
WantedBy=default.target
